# Where2Go 配置样例 —— 复制为 .env 后按需填写(cp .env.example .env)
# 全部可留空:服务照样起,打开 http://localhost:8000/setup 走向导配置(存数据库,重建不丢)。
# 优先级:本文件/容器 env > 向导存的数据库配置(见 docs/CONTAINER-SETUP-PLAN.md §2)。

# ============================================================
# 必填(否则地图与目的地检索不可用)——高德开放平台 https://console.amap.com
# 同一个应用下要建两个不同平台的 key,不能混用(混用报 USERKEY_PLAT_NOMATCH):
# ============================================================

# ① 高德「Web服务」key(后端用:地理编码/POI 检索/驾车路线)
WHERE2GO_AMAP_KEY=

# ② 高德「Web端(JS API)」key + 安全密钥(前端地图用;创建 key 时选「Web端(JSAPI)」)
#    安全密钥必须配,否则地图报 INVALID_USER_SCODE
WHERE2GO_AMAP_JS_KEY=
WHERE2GO_AMAP_SECURITY_JS_CODE=

# ============================================================
# 可选:LLM(AI 简介/推荐/长介绍/行程规划/助手)。不配也能用,只是没有 AI 功能。
# 任意 OpenAI 兼容服务均可(POST {BASE_URL}/chat/completions)。
# ============================================================

# 预置档:qwen(阿里百炼)/ deepseek;留空 = 按下列 key 自动挑
WHERE2GO_LLM_PROVIDER=
WHERE2GO_LLM_API_KEY=
# 自定义服务才需要(留空用 PROVIDER 预置端点/模型):
WHERE2GO_LLM_BASE_URL=
WHERE2GO_LLM_MODEL=
# 兼容老口径:配了下面任一个也能被识别为对应预置档
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=

# ============================================================
# 可选:运行时口径(都有合理默认值,一般不用动;完整说明见 README)
# ============================================================

# 数据库位置(容器内默认 /data 卷,勿改,否则升级丢数据)
# WHERE2GO_DB_URL=sqlite:////data/where2go.db

# 高德请求最小间隔秒(默认 0.6;调小会触发 QPS 限流 infocode=10021)
# WHERE2GO_AMAP_MIN_INTERVAL_S=0.6

# 起点缓存 TTL 秒(默认 604800 = 7 天)
# WHERE2GO_ORIGIN_CACHE_TTL_S=604800

# 驾车费用估算油价 元/L(默认 8.0)
# WHERE2GO_FUEL_PRICE_CNY_L=8.0

# 人工种子数据(国内滑雪/运动垫底;默认开。关闭填 off)
# WHERE2GO_SEEDS=off

# POI 图片缓存 TTL 秒(默认 604800)/ 空结果负缓存(默认 21600)/ 单 POI 图片上限(默认 6,最多 20)
# WHERE2GO_PLACE_MEDIA_TTL_S=604800
# WHERE2GO_PLACE_MEDIA_MISS_TTL_S=21600
# WHERE2GO_PLACE_MEDIA_MAX_IMAGES=6

# 数据源端点覆盖(默认官方端点,一般不用动)
# WHERE2GO_AMAP_ENDPOINT=https://restapi.amap.com/v3
# WHERE2GO_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
# WHERE2GO_PHOTON_ENDPOINT=https://photon.komoot.io
# WHERE2GO_OSRM_ENDPOINT=https://router.project-osrm.org
# WHERE2GO_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# WHERE2GO_WIKI_API=https://zh.wikipedia.org/w/api.php
# WHERE2GO_COMMONS_API=https://commons.wikimedia.org/w/api.php

# 分数据源代理口径:off=直连 / env=沿用 HTTP(S)_PROXY / 其他值=代理 URL
# (默认:高德/Photon/OSRM/携程直连,Overpass/Nominatim/LLM/维基沿用环境代理)
# ⚠️ 境外轨(TASK-27,2026-10-18 实测):国内网络直连 overpass-api.de 报 502、
#    nominatim.openstreetmap.org 报 Network unreachable;配了 HTTPS_PROXY 后
#    Nominatim 0.69s、Overpass 30.9s 均可用。**要支持境外目的地,必须配下面这组代理**。
# WHERE2GO_PROXY_AMAP=off
# WHERE2GO_PROXY_NOMINATIM=env
# WHERE2GO_PROXY_PHOTON=off
# WHERE2GO_PROXY_LLM=env
# WHERE2GO_PROXY_OVERPASS=env
# WHERE2GO_PROXY_OSRM=off
# WHERE2GO_PROXY_WIKIMEDIA=env

# ============================================================
# 境外目的地代理(可选;不配则境外轨搜不出结果,境内功能不受影响)
# 境外链的 Nominatim / Overpass 在国内直连不通,只能走代理(HTTP 代理即可)。
# 留空 = 直连 = 境外目的地不可用;境内(高德)链路与代理无关。
# ============================================================
# HTTPS_PROXY=http://192.168.1.210:7892
# HTTP_PROXY=http://192.168.1.210:7892
# NO_PROXY=localhost,127.0.0.1,restapi.amap.com,photon.komoot.io,router.project-osrm.org

# 境外轨 Overpass 并发(默认 3)
# WHERE2GO_OVERPASS_WORKERS=3

# UI 模式:release=发布版(隐藏技术细节,容器默认)/ dev=开发版(状态栏全量口径)
# WHERE2GO_UI_MODE=release
