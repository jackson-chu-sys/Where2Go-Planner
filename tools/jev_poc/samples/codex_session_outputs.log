function routeEnds(){
  const panel=state.routePanel;
  const data=panel.data||{};
  const from=data.from||state.origin;
  const to=data.to||panel.place;
  if(!coordsReady(from)||!coordsReady(to)) return null;
  return {from:[num(from.lat),num(from.lng)],to:[num(to.lat),num(to.lng)]};
}

function routeTooltip(route,schematic){
  const label=route.label||ROUTE_MODE_LABEL[route.mode]||route.mode||"路线";
  const badge=(KIND_BADGE[route.kind]||KIND_BADGE.estimate).text;
  const figs=[fmtDuration(route.duration_min),fmtCost(route.cost_cny),fmtKm(route.distance_km)].join(" · ");
  return label+" "+figs+"("+badge+")"+(schematic?" · 示意线,非真实轨迹":" · OSRM 真实折线");
}

function clearRouteLine(){
  if(routeLayer) routeLayer.clearLayers();
  routeLine=null;
}

// 画线:驾车有 geometry 就画真实折线(抽稀后),铁路/飞机(以及 OSRM 降级)画起终点示意线;
// 先清后画 → 同一时刻地图上只有一条路线
function drawRouteLine(route){
  clearRouteLine();
  if(!map||!routeLayer||!route) return;
  const ends=routeEnds();
  if(!ends) return;
  let points=(Array.isArray(route.geometry)&&route.geometry.length>1)
    ? thinPoints(route.geometry,ROUTE_MAX_POINTS):null;
  const schematic=!points||points.length<2;
  if(schematic) points=(route.mode==="flight")?arcPoints(ends.from,ends.to,ROUTE_FLIGHT_BOW):[ends.from,ends.to];
  const style=ROUTE_LINE_STYLE[route.mode]||ROUTE_LINE_STYLE.rail;
  routeLine=L.polyline(points,{color:style.color,weight:style.weight,opacity:style.opacity,
    dashArray:style.dashArray||null});
  routeLine.bindTooltip(routeTooltip(route,schematic),{sticky:true});
  routeLayer.addLayer(routeLine);
}

function selectRouteMode(mode,fit){
  state.routePanel.mode=mode;
  const cards=document.querySelectorAll("#routeCards .rcard");
  Array.prototype.forEach.call(cards,card=>{
    const on=(card.getAttribute("data-mode")===mode);
    card.classList.toggle("sel",on);
    card.setAttribute("aria-pressed",on?"true":"false");
  });
  drawRouteLine(currentRoute());
  if(fit&&map&&routeLine&&routeLine.getBounds) map.fitBounds(routeLine.getBounds(),{padding:[40,40],maxZoom:12});
}

function applyRouteData(data){
  state.routePanel.data=data;
  const routes=(data&&Array.isArray(data.routes))?data.routes:[];
  renderRouteMeta(data);
  if(!routes.length){
    renderRouteCards([]);
    showRouteLegend(false);
    clearRouteLine();
    setRouteMsg("这条起终点暂时给不出路线(后端返回空)。换个目的地,或重设起点后再试。","warn");
    return;
  }
  renderRouteCards(routes);
  setRouteMsg("");
  showRouteLegend(true);
  // 默认选中能画出真实折线的那条(通常是驾车),OSRM 降级时退回第一条有数字的
  const preferred=routes.find(route=>!route.degraded&&Array.isArray(route.geometry)&&route.geometry.length>1)||
                  routes.find(route=>!route.degraded)||routes[0];
  selectRouteMode(preferred?preferred.mode:null,false);
}

async function loadRoutes(place,token){
  const params=new URLSearchParams({from_lat:String(state.origin.lat),from_lng:String(state.origin.lng),
