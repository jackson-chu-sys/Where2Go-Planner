function renderRouteMeta(data){
  const box=$("routePanelMeta");
  if(!box) return;
  if(!data){box.textContent="";return;}
  const parts=[];
  const km=num(data.distance_km);
  if(isFinite(km)) parts.push("起终点直线 "+km.toFixed(1)+" km");
  if(data.generated_at) parts.push("生成于 "+fmtGeneratedAt(data.generated_at));
  parts.push((data.cost_model&&data.cost_model.disclaimer)||ROUTE_DISCLAIMER);
  if(data.elapsed_s!==null&&data.elapsed_s!==undefined) parts.push("规划耗时 "+data.elapsed_s+"s");
  box.textContent=parts.join(" · ");
}

