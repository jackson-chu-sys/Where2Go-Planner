}
function fmtCost(cny){
  const value=num(cny);
  return isFinite(value)?("¥"+Math.round(Math.max(0,value))):"—";
}
function fmtKm(km){
  const value=num(km);
  return isFinite(value)?(Math.max(0,value).toFixed(1)+" km"):"—";
}
// 后端 generated_at 是 ISO(UTC);统一显示成 "YYYY-MM-DD HH:MM UTC",解析不了就原样显示
function fmtGeneratedAt(value){
  if(!value) return "";
  const stamp=new Date(String(value));
  if(isNaN(stamp.getTime())) return String(value);
  const pad=item=>String(item).padStart(2,"0");
  return stamp.getUTCFullYear()+"-"+pad(stamp.getUTCMonth()+1)+"-"+pad(stamp.getUTCDate())+
    " "+pad(stamp.getUTCHours())+":"+pad(stamp.getUTCMinutes())+" UTC";
}

// 折线抽稀:等间隔取点、**首尾必留**(后端已按 GEOMETRY_MAX_POINTS 抽过,这里再收一道,
// 免得长路线几千个点把画线拖慢;坏点直接丢掉,不抛错)
function thinPoints(points,max){
  const coords=[];
  (points||[]).forEach(pair=>{
    const lat=num(pair&&pair[0]),lng=num(pair&&pair[1]);
    if(isFinite(lat)&&isFinite(lng)) coords.push([lat,lng]);
  });
  if(coords.length<3||!max||max<2||coords.length<=max) return coords;
  const step=(coords.length-1)/(max-1);
  const picked=[];
  for(let index=0;index<max-1;index++) picked.push(coords[Math.round(index*step)]);
  picked.push(coords[coords.length-1]);
  return picked;
}

// 飞机示意线:起终点之间拉一条二次贝塞尔弧(垂直偏移 bow),看起来像航段而不是铁轨
function arcPoints(from,to,bow){
  const points=[];
  const midLat=(from[0]+to[0])/2,midLng=(from[1]+to[1])/2;
  const dLat=to[0]-from[0],dLng=to[1]-from[1];
  const ctrlLat=midLat-dLng*(bow||0),ctrlLng=midLng+dLat*(bow||0);
  for(let index=0;index<=ROUTE_ARC_SEGMENTS;index++){
    const t=index/ROUTE_ARC_SEGMENTS,inv=1-t;
    points.push([inv*inv*from[0]+2*inv*t*ctrlLat+t*t*to[0],
                 inv*inv*from[1]+2*inv*t*ctrlLng+t*t*to[1]]);
  }
  return points;
}

