async function loadPlaces(refresh){
  if(!state.origin) return;
  showErr("");setBusy(true);
  const known=state.cached[state.band];
  if(refresh) setStatus("正在重新抓取 Overpass 四分类并集(公共源较慢,约 20-120s)…");
  else if(known===undefined) setStatus("该分段尚未入库,正在抓取 Overpass 四分类并集(约 20-120s)…");
  else setStatus("正在读取本地库(已入库,不触网)…");
  const params=new URLSearchParams({origin:state.origin.city,band:state.band,
    lat:String(state.origin.lat),lng:String(state.origin.lng)});
  if(state.category) params.set("category",state.category);
  if(refresh) params.set("refresh","true");
  try{
    const data=await getJSON("/api/places?"+params.toString());
    state.origin=data.origin;
    state.bandMeta=data.band;
    const total=Object.values(data.counts_by_category||{}).reduce((sum,value)=>sum+value,0);
    state.cached[state.band]=total;
    renderBandOptions();drawRings();fitRings();drawPins(data.places);renderLegend(data.counts_by_category);
    const from=(data.source==="db")?"本地 SQLite 读库(未触网)":"Overpass 实时抓取 → 已入库";
    const fetched=data.fetched_at?(" · 抓取于 "+esc(String(data.fetched_at).replace("T"," ").replace("+00:00","Z"))):"";
    setStatus('起点 <b>'+esc(data.origin.name)+"</b> · "+esc(data.band.label)+
      " · 分类 <b>"+esc(state.category||"全部")+"</b> · 显示 <b>"+data.count+"</b> / 库内 "+total+
      " 条 · 来源:"+from+sourceNote(data)+fetched+" · 耗时 "+data.elapsed_s+"s"+introNote(data));
    if(!data.count) showErr("该分段/分类下暂无已入库目的地,可换分段、换分类,或点「重新抓取」。");
  }catch(error){
    showErr("查询失败:"+error.message);setStatus("查询失败");
  }finally{setBusy(false);}
}

// 来源计数:OSM 抓取 vs 人工种子(TASK-1c 补 OSM 国内滑雪/运动缺口);没种子就不占状态栏
function sourceNote(data){
  const counts=data.counts_by_source||{};
  const seeds=counts[SEED_SOURCE]||0;
  if(!seeds) return "";
  const fresh=(data.seeded>0)?("(本次补种 "+data.seeded+" 条)"):"";
  return " · 人工种子 <b>"+seeds+"</b> 条"+fresh+" / OSM "+(counts["OSM"]||0)+" 条";
}

// 简介进度:抓取路径会带回本次 LLM 生成统计;读库路径只报还缺多少条
function introNote(data){
  const stats=data.intro_stats;
  if(stats) return " · 简介:新增 <b>"+stats.filled+"</b> 条 / 降级 "+stats.failed+" 条 · 仍缺 "+data.intro_pending+" 条";
  return (data.intro_pending>0)?(" · 待补简介 <b>"+data.intro_pending+"</b> 条(点「补简介」)"):"";
}

// 补简介:给该分段还没有 intro 的 POI 调 LLM(DB 即缓存,已有的不重复调用)
async function fillIntros(){
  if(!state.origin) return;
  showErr("");setBusy(true);
  setStatus("正在调 LLM 补缺失简介(最多 "+INTRO_LIMIT+" 条,已有简介的跳过)…");
  const params=new URLSearchParams({origin:state.origin.city,band:state.band,limit:String(INTRO_LIMIT)});
  if(state.category) params.set("category",state.category);
  try{
    const data=await getJSON("/api/places/intros?"+params.toString());
    const summary="简介:生成 <b>"+data.filled+"</b> 条 · 降级 "+data.failed+
      " 条 · 仍缺 "+data.pending+" 条 · "+esc(data.provider||"LLM")+" · 耗时 "+data.elapsed_s+"s";
    if(data.filled>0){await loadPlaces(false);setStatus($("status").innerHTML+" · "+summary);}
    else{
      setStatus(summary);
      showErr(data.scanned===0?"该分段没有缺简介的 POI(或 LLM 未配置 key)。"
        :"本次没有拿到新简介(LLM 调用降级),可稍后再点「补简介」重试。");
    }
  }catch(error){
    showErr("补简介失败:"+error.message);setStatus("补简介失败");
  }finally{setBusy(false);}
}

