// 卡片选中与跳转都走事件委托(卡片/链接都是运行时 innerHTML 生成的)
function onDocumentClick(event){
  const target=event.target;
  if(!target||!target.closest) return;
  const popupButton=target.closest(".js-routes");
  if(popupButton){
    const place=state.places[Number(popupButton.getAttribute("data-i"))];
    if(place) openRoutePanel(place,{scroll:true});
    return;
  }
  if(target.closest("#routePanel a")) return;   // 跳转链接自己开新页,不算选卡片
  const card=target.closest("#routeCards .rcard");
  if(card) selectRouteMode(card.getAttribute("data-mode"),true);
}

// 键盘可达:Enter/空格选中卡片(画线),Esc 关面板清线
function onDocumentKeydown(event){
  if(event.key==="Escape"){closeRoutePanel();return;}
  if(event.key!=="Enter"&&event.key!==" "&&event.key!=="Spacebar") return;
  const target=event.target;
  if(!target||!target.closest) return;
  const card=target.closest("#routeCards .rcard");
  if(!card) return;
  event.preventDefault();
  selectRouteMode(card.getAttribute("data-mode"),true);
}

function drawPins(places){
  if(!pins) return;
  closeRoutePanel();   // 换 band/分类/起点或重抓:旧 pin 可能已不在图上,面板与画线一并清掉
  state.places=places||[];
  pins.clearLayers();
  state.places.forEach((place,index)=>{
    const meta=categoryMeta(place.category);
    const icon=L.divIcon({className:"",iconSize:[26,26],iconAnchor:[13,26],popupAnchor:[0,-24],
      html:'<div class="pin" style="background:'+meta.color+'"><span>'+meta.emoji+"</span></div>"});
    const marker=L.marker([place.lat,place.lng],{icon:icon,title:place.name||""});
    marker.bindPopup(popupHtml(place,index));
    marker.on("popupopen",()=>openRoutePanel(place));   // 点 pin → 侧栏路线面板自动展开
    pins.addLayer(marker);
  });
}

async function loadMeta(){
  state.meta=await getJSON("/api/places/meta");
  if(!state.meta.bands.some(band=>band.key===state.band)) state.band=state.meta.bands[0].key;
  renderBandOptions();renderCategoryOptions();renderLegend({});renderCityHints();
}

function renderCityHints(){
  $("cityList").innerHTML=CITY_HINTS.map(name=>'<option value="'+esc(name)+'"></option>').join("");
}

// 起点城市搜索:复用后端 /api/geocode(Nominatim),顺便拿到"哪些分段已入库"。
// 空输入与"没搜到"都不当错误:给可见提示并**保留当前起点**(地图与已渲染的 pin 不动)。
async function searchCity(city){
  const name=(city||"").trim();
  if(!name){
    showNote("请输入起点城市名(如:北京、上海、崇礼),或点「📍 我的位置」用浏览器定位。",true);
    return;
  }
  clearMessages();setBusy(true);
  setStatus('正在用 Nominatim 定位「'+esc(name)+'」…');
  try{
    applyOrigin(await getJSON("/api/geocode?city="+encodeURIComponent(name)));
    await loadPlaces(false);
  }catch(error){
    const message=String(error.message||"");
    const kept=state.origin?("起点保持为「"+state.origin.name+"」"):"";
    if(message.indexOf("未找到")>=0){
      showNote('没有找到与「'+name+"」匹配的城市"+(kept?(","+kept):"")+
        "。可换个写法(带上省份,如「河北 崇礼」),或点「📍 我的位置」。",true);
      setStatus(kept?("起点未变:"+esc(state.origin.name)):"起点定位失败");
    }else{
      showErr("城市定位失败:"+message+(kept?("("+kept+")"):""));
      setStatus(kept?("起点未变:"+esc(state.origin.name)):"起点定位失败");
    }
  }finally{setBusy(false);}
}

// 起点落地(城市搜索与浏览器定位共用):换 state、清分段计数缓存、重画范围圈并 fit
function applyOrigin(data){
  state.origin=data.origin;
  state.cached={};
  state.routeCache={};   // 起点变了 → 已缓存的路线全部作废
  closeRoutePanel();     // 面板标题/画线都以旧起点为前提,一并收掉
  (data.segments||[]).forEach(seg=>{state.cached[seg.band]=seg.place_count;});
  renderBandOptions();drawRings();fitRings();
}

