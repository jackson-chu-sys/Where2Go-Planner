}

RAIL_MIN_KM = 100.0     # 直线距离 >= 才出现铁路
FLIGHT_MIN_KM = 300.0   # 直线距离 >= 才出现飞机
RAIL_DETOUR = 1.20      # 铁路路径绕行系数(相对直线)
